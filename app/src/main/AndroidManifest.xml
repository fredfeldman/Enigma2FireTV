<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declare TV features; required=false so it also runs on FireTV sticks -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Enigma2FireTV"
        android:usesCleartextTraffic="true">

        <!-- Main launcher activity for TV / FireTV -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen video player activity -->
        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Enigma2FireTV.Player"
            android:launchMode="singleTop" />

        <!-- Settings activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Enigma2FireTV.Settings" />

        <!-- Hidden bouquets picker (launched from Settings) -->
        <activity
            android:name=".ui.settings.HideBouquetsActivity"
            android:exported="false"
            android:theme="@style/Theme.Enigma2FireTV.Settings" />

        <!-- Bouquet editor (launched from Settings) -->
        <activity
            android:name=".ui.bouqueteditor.BouquetEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.Enigma2FireTV.Settings" />

        <!-- EPGImport sources viewer (launched from Settings) -->
        <activity
            android:name=".ui.epgimport.EpgImportActivity"
            android:exported="false"
            android:theme="@style/Theme.Enigma2FireTV.Settings" />

        <!-- v1.1.0: Virtual remote control (launched from Settings) -->
        <activity
            android:name=".ui.remote.RemoteControlActivity"
            android:exported="false"
            android:theme="@style/Theme.Enigma2FireTV.Settings" />

        <!-- v1.1.0 Phase 1: Receiver Settings hub (13 sub-screens) -->
        <activity
            android:name=".ui.settings.receiver.ReceiverSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Enigma2FireTV.Settings" />

        <!-- Standalone IPTV player (no Enigma2 required) -->
        <activity
            android:name=".ui.iptv.IptvActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.Enigma2FireTV" />

        <!-- v1.1.0: EPG reminder alarm receiver -->
        <receiver
            android:name=".service.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.enigma2.firetv.ACTION_REMINDER_WATCH" />
                <action android:name="com.enigma2.firetv.ACTION_REMINDER_SNOOZE" />
            </intent-filter>
        </receiver>

    </application>

    <!-- v1.2.0 Phase 5: visibility of external video player apps (API 30+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-mpegURL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.apple.mpegurl" />
        </intent>
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="org.xbmc.kodi" />
        <package android:name="org.xbmc.kodi19" />
        <package android:name="org.xbmc.kodi20" />
    </queries>

</manifest>
